      "map": {
        "destination": "Anyone with a lar server signs in on lar.app with an owner account and streams their library away from home through a relay, with no port forwarding. The server registers with the cloud once; clients find it by account.",
        "decisions": [
          "Owner accounts live in the cloud, not on each server (#203 research).",
          "Hosting the relay costs about $40 a month for the first 500 owners (#203).",
          "Sign-in uses passkeys first, email links as fallback."
        ],
        "fog": [
          "Does the relay only broker connections, or carry the stream too (full TURN)? (#201)",
          "What does the sign-in screen look like on the website and in the apps? (#202)"
        ],
        "check": {
          "title": "Sign in on the website, then stream from a phone off Wi-Fi",
          "steps": [
            "Create an owner account on lar.app",
            "Register a server with the account",
            "Open the app on cellular and play a 4K title"
          ]
        }
