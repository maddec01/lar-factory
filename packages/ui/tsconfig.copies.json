// The Copies keep T3's imports, extensionless and through `~` for src/, which need Bundler resolution
// (as in T3's apps/web/tsconfig.json). coss's toast, in src/coss, imports `@/registry/default/lib/utils`, mapped to
// the board's cn, and `@/registry/default/ui/button`, mapped to T3's button, whose buttonVariants it uses. The board's own components sit here too, in src/dialog, which loads
// the Copies, and in src/card, src/form and src/progress, so that each JSX file uses the same settings, and
// src/env.ts, which a Copy imports as `~/env`. The board's other files stay on tsconfig.json. The other options match apps/web's, which type-checks the Copies it imports the same way (docs/adr/0016).
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"],
      "@/registry/default/lib/utils": ["./src/lib/utils.ts"],
      "@/registry/default/ui/button": ["./src/components/ui/button.tsx"]
    }
  },
  "include": ["src/card", "src/coss", "src/components/MorphIcon.tsx", "src/components/ui", "src/design-system", "src/dialog", "src/env.ts", "src/form", "src/hooks", "src/lib/visibleAnimation.ts", "src/lib/windowControlsOverlay.ts", "src/progress", "src/rich-text"]
}
