{
  "name": "mux-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test:shared": "pnpm --filter @mux-factory/shared test",
    "test:server": "pnpm --filter @mux-factory/server test",
    "test:web": "pnpm --filter @mux-factory/web test",
    "test:desktop": "pnpm --filter @mux-factory/desktop test",
    "typecheck": "tsc --noEmit -p . && pnpm -r run typecheck",
    "sample": "pnpm --filter @mux-factory/server sample",
    "dev": "pnpm --filter @mux-factory/desktop dev",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "knip": "6.42.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  }
}
