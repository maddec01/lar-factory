{
  "name": "mux-factory-board",
  "private": true,
  "version": "0.1.0",
  "description": "Local board for the Mux factory: reads the Mux GitHub Project through gh and shows it as a board and an outline of how items relate.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch --watch-path=src src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "test:update": "UPDATE_EXPECTED=1 node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "sample": "BOARD_DATA_FILE=test/sample.json node --disable-warning=ExperimentalWarning src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
